# Normalise line endings so the same checkout works on Windows, macOS, and in a
# Linux container. Without this, Windows checkouts would produce CRLF files and
# the Docker build, which runs on Linux, would see them as modified.

* text=auto eol=lf

*.py    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.css   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.cpp   text eol=lf
*.h     text eol=lf
Dockerfile text eol=lf
.gitignore    text eol=lf
.dockerignore text eol=lf

# Binary assets are never line-ending translated.
*.jpg  binary
*.jpeg binary
*.png  binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.onnx binary
*.whl  binary
*.gz   binary
*.tar.gz binary
