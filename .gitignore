# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
.env
.env.*
!.env.example
*.egg-info/
.eggs/
build/
dist/

# Tool caches. These change on every lint or test run, so committing them creates
# constant noise in review and invalidates Docker's build cache checksum.
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---------------------------------------------------------------------------
# Node / Next.js
# ---------------------------------------------------------------------------
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
next-env.d.ts.timestamp

# Test-run output. Playwright writes traces and screenshots on failure, which can
# include the uploaded document images.
test-results/
playwright-report/
blob-report/
playwright/.cache/

# ---------------------------------------------------------------------------
# Runtime state. Regenerated by every run, and it can contain user documents.
# ---------------------------------------------------------------------------
data/
outputs/

# ---------------------------------------------------------------------------
# Local scratch
# ---------------------------------------------------------------------------
wheels/
*.log
npm-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ---------------------------------------------------------------------------
# Deliberately NOT ignored. These are part of the deliverable and must be pushed:
#
#   vendor/                     the one pinned source distribution PyPI no longer
#                               serves; without it the OCR engine will not start
#   dataset/                    the self-created scenario dataset, including the
#                               no-document failure case required by the brief
#   Sample Card Test Case/      the supplied study images
#   Design/                     the design references the UI was built against
#   VALID_TEST_EXTRACTION.md    the curated ground truth used to score extraction
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# Assignment working documents. These are the reviewer's own brief and planning notes, not
# part of the application, so they stay on disk but are never committed. The machine-readable
# ground truth the tests and the scorer use is tests/fixtures/valid_extraction.json.
# ---------------------------------------------------------------------------
BRIEF.md
PRD*.md
AUDIT_REPORT.md
VALID_TEST_EXTRACTION.md
